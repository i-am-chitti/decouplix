<?xml version="1.0"?>
<ruleset name="Decouplix Rules">
	<description>WordPress Coding Standards for Decouplix plugin</description>

	<!-- Target paths to scan -->
	<file>.</file>

	<!-- Scan only PHP files -->
	<arg name="extensions" value="php"/>

	<!-- Exclude paths -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<!-- Show progress, colors, and sniff codes -->
	<arg value="ps"/>
	<arg name="colors"/>

	<!-- Set target PHP version -->
	<config name="testVersion" value="7.4-"/>

	<!-- Include WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Disable class file name standards because we chose modern PSR-4 PascalCase filenames -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Disable PrefixAllGlobals because our prefix "hc" is shorter than the WPCS minimum length, which triggers false warnings for constants/hooks -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
	</rule>

	<!-- Rule to enforce our text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="decouplix"/>
			</property>
		</properties>
	</rule>
</ruleset>
